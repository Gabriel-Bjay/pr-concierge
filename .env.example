# `npm run setup` fills these in for you. Copy to .env only if you register the app by hand.

APP_ID=
PRIVATE_KEY_PATH=./private-key.pem
# On hosting platforms, paste the key inline instead (use \n for line breaks):
# PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=

# Development only: smee.io channel that relays GitHub webhooks to localhost.
WEBHOOK_PROXY_URL=

PORT=3000

# Post stale-review reminders every N hours (0 = off). Or schedule `npm run remind` instead.
REMINDER_INTERVAL_HOURS=0

# GitHub Enterprise Server only, e.g. https://ghe.example.com/api/v3
# GITHUB_API_URL=
