{
  "name": "pr-concierge",
  "version": "0.1.0",
  "description": "A GitHub App that labels pull requests by size, checks PR hygiene, and nudges reviewers on stale reviews.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "remind": "tsx src/remind.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/webhooks": "^14.2.0",
    "octokit": "^5.0.5",
    "picomatch": "^4.0.7",
    "smee-client": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
